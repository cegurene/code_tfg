<mujoco model="MIMo_lower">

	<body childclass="mimo" name="hip" pos="0 0 0">
		<geom name="lb" type="capsule" size=".048 .043" mass="1.1584" material="pants_down" pos="-.002 0 0.005" euler="90 0 0"/>
		<site name="lowerBody_center" type="sphere" size=".01 .01 .01" pos="0 0 0"/>
		<site name="BODY_25:MidHip" type="sphere" size=".005" pos="0.005 0 -0.007" rgba="0 0 0 1"/>

		<body name="lower_body" pos="0.002 0 0.076">
			<joint name="robot:hip_lean1" type="hinge" pos="0 0 -.05" axis="1 0 0" range="-14 14" stiffness="3.38" damping="0.77" frictionloss=".049" armature="0.01"/>
			<joint name="robot:hip_rot1" type="hinge" pos="0 0 -.05" axis="0 0 1" range="-18 18" stiffness="1.45" damping="0.29" frictionloss=".018" armature="0.01"/>
			<joint name="robot:hip_bend1" type="hinge" pos="0 0 -0.05" axis="0 1 0" range="-17 30.5" stiffness="2.20" damping="0.84" frictionloss="0.040" armature="0.01"/>
			<site name="torque_lb" type="sphere" size="0.01" pos="0 0 0" group="4"/>
			<geom name="cb" type="capsule" size=".053 .035" mass="1.3245" material="pants_up" contype="0" pos="0.005 0 -.008" euler="90 0 0"/>
		</body>

		<!-- 601 grams with motor, motor is 368 grams, default in script is 7998 grams -->
		<!-- CoM is in 15-20%, default in script is 0.0645 (32,412%) -->

		<!-- BODY
			name: name of the body
			pos: the 3D position of the body frame, in the parent coordinate frame
		-->

		<!-- JOINT
			name: name of the joint
			type (hinge): 1 DoF joint
			pos: position of the joint
			axis: axis of rotation
			range: joint limits
			stiffness: joint stiffness ( f(x)=−(ax+bx2+cx3) , x = joint displacement from equilibrium, b and c are optional)
			damping: damping coefficients ( f(v)=-(av+bv|v|+cv3) , v = joint velocity, b and c are optional)
			frictionloss: friction loss due to dry friction
			armature: additional inertia associated with movement of the joint that is not due to body mass (e.g. motor inertia)
		-->
		
		<!-- GEOM
			name: name of the geom
			type (capsule): cylinder capped with 2 half-spheres, oriented along the x axis
			contype and conaffinity: 32-bit integer. if the contype of one geom is compatible with the conaffinity of the other geom or vice versa.
									Compatible means that the two bitmasks have a common bit set to 1.
			size: size parameters (capsule needs 1 or 2). Radius of the capsule; half-length of the cylinder part when not using the fromto specification
			mass: mass of the geom
			pos: position of the geom, specified in the frame of the body where the geom is defined
		-->

		<!-- SITE
			name: name of the site
			type (sphere): shape of the site
			size: sizes of the geometric shape representing the site
			pos: position of the site frame
			group: integer group to which the site belongs
			rgba: color and transparency
		-->

		<body name="right_upper_leg" pos="0.005 -.051 -.007">
			<!-- 
				Cylinder part: 2⋅0.0625 = 0.125 m
				End caps (hemispheres): 2⋅0.037 = 0.074 m
				Total capsule length: 0.125+0.074 = 0.199 m = 19.9 cm
			-->
			<joint name="robot:right_hip1" type="hinge" pos="0 0 0" axis="0 1 0" springref="-10" range="-133 20" stiffness="1.72" damping="1.27" frictionloss=".08" armature=".005"/>
			<joint name="robot:right_hip2" type="hinge" pos="0 0 0" axis="1 0 0" range="-51 17" stiffness="3.51" damping="1.99" frictionloss=".062" armature=".005"/>
			<joint name="robot:right_hip3" type="hinge" pos="0 0 0" axis="0 0 -1" range="-32 41" stiffness="2.16" damping="0.75" frictionloss=".027" armature=".005"/>
			<site name="torque_right_hip" type="sphere" size="0.01" pos="0 0 0" group="4"/>
			<site name="BODY_25:RHip" type="sphere" size=".005 .005 .005" pos="0 0 0" rgba="0 0 0 1"/>
			<geom name="geom:right_upper_leg1" type="capsule" material="pants_leg" contype="2" conaffinity="3" size=".037 .0625" mass=".601" pos="0 0 -.0645" euler="0 0 0"/>

		</body>

		<body name="left_upper_leg" pos="0.005 .051 -.007">
			<!-- 
				Cylinder part: 2⋅0.0625 = 0.125 m
				End caps (hemispheres): 2⋅0.037 = 0.074 m
				Total capsule length: 0.125+0.074 = 0.199 m = 19.9 cm
			-->
			<joint name="robot:left_hip1" type="hinge" pos="0 0 0" axis="0 1 0" springref="-10" range="-133 20" stiffness="1.72" damping="1.27" frictionloss=".08" armature=".005"/>
			<joint name="robot:left_hip2" type="hinge" pos="0 0 0" axis="-1 0 0" range="-51 17" stiffness="3.51" damping="1.99" frictionloss=".062" armature=".005"/>
			<joint name="robot:left_hip3" type="hinge" pos="0 0 0" axis="0 0 1" range="-32 41" stiffness="2.16" damping="0.75" frictionloss=".027" armature=".005"/>
			<site name="torque_left_hip" type="sphere" size="0.01" pos="0 0 0" group="4"/>
			<site name="BODY_25:LHip" type="sphere" size=".005 .005 .005" pos="0 0 0" rgba="0 0 0 1"/>
			<geom name="geom:left_upper_leg1" type="capsule" material="pants_leg" contype="2" conaffinity="3" size=".037 .0625" mass=".601" pos="0 0 -.0645" euler="0 0 0"/>

		</body>
        
	</body>

</mujoco>
